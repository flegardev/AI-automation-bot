# AI Automation Bot & LLM Orchestration Engine Configuration

# Server & Runtime Port
VITE_APP_PORT=3004
VITE_APP_ENV=development

# Primary & Fallback LLM Provider API Keys (Leave blank or fill with your private key)
# DO NOT COMMIT REAL KEYS TO SOURCE CONTROL
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# LLM Orchestrator Tuning & Circuit Breaker Limits
VITE_MAX_RETRIES=4
VITE_INITIAL_BACKOFF_MS=500
VITE_MAX_BACKOFF_MS=8000
VITE_RATE_LIMIT_TOKENS_PER_MINUTE=60000
VITE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
VITE_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
